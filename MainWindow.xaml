<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="900" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Fg}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <Grid x:Name="Root">

    <!-- shown after a swipe up: hover / click / pull down to bring the island back -->
    <Grid x:Name="Handle" Width="150" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top"
          Background="#01000000" Visibility="Collapsed" Cursor="Hand"
          MouseEnter="Handle_MouseEnter" MouseLeave="Handle_MouseLeave"
          MouseLeftButtonDown="Handle_MouseLeftButtonDown" MouseMove="Handle_MouseMove">
      <Border x:Name="HandlePill" Width="56" Height="6" CornerRadius="3" VerticalAlignment="Top" Margin="0,3,0,0"
              Background="{DynamicResource IslandBg}" BorderBrush="{DynamicResource Fg3}" BorderThickness="0.8"
              Opacity="0.85"/>
    </Grid>

    <!-- The island. Its body is a Path rebuilt every frame while it moves, so the outline can ripple like liquid. -->
    <Border x:Name="Island"
            Background="Transparent"
            Width="200" Height="36"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
            RenderTransformOrigin="0.5,0"
            MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
            PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
            PreviewMouseMove="Island_PreviewMouseMove"
            PreviewMouseLeftButtonUp="Island_PreviewMouseLeftButtonUp"
            SizeChanged="Island_SizeChanged"
            AllowDrop="True" DragEnter="Island_DragEnter" DragLeave="Island_DragLeave" Drop="Island_Drop">
      <Border.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="IslandScale"/>
          <SkewTransform x:Name="IslandSkew"/>
          <TranslateTransform x:Name="IslandShift"/>
        </TransformGroup>
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect BlurRadius="34" ShadowDepth="6" Opacity="0.38" Color="Black" Direction="270"/>
      </Border.Effect>
      <Border.ContextMenu>
        <ContextMenu x:Name="IslandMenu">
          <MenuItem Header="Спрятать (смахнуть вверх)" Click="HideIsland_Click"/>
          <MenuItem Header="Сменить тему" InputGestureText="Ctrl+Alt+T" Click="ToggleTheme_Click"/>
          <MenuItem Header="Настройки" Click="OpenSettings_Click"/>
          <Separator/>
          <MenuItem Header="Выход" Click="Exit_Click"/>
        </ContextMenu>
      </Border.ContextMenu>

      <Grid>
      <!-- liquid glass body: tint + rim light, then a soft specular shine on top -->
      <Path x:Name="IslandShape" Fill="{DynamicResource IslandBg}" Stroke="{DynamicResource GlassRim}" StrokeThickness="1"/>
      <Path x:Name="IslandShine" Fill="{DynamicResource GlassShine}" IsHitTestVisible="False"/>

      <Grid x:Name="IslandContent">

        <!-- ================= COMPACT ================= -->
        <Grid x:Name="CompactView" Height="36" VerticalAlignment="Top" Margin="15,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Grid VerticalAlignment="Center" Margin="0,0,10,0">
            <!-- live activity icon (timer ring, download, Discord, focus, calendar…) -->
            <Grid x:Name="LiveSlot" Width="22" Height="22" Visibility="Collapsed">
              <Ellipse x:Name="LiveRingBg" Stroke="{DynamicResource TrackBg}" StrokeThickness="2.5"/>
              <Path x:Name="LiveRing" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <TextBlock x:Name="LiveIcon" FontFamily="{StaticResource IconFont}" FontSize="11"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel x:Name="Eyes" Orientation="Horizontal" RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="EyesScale"/>
                  <TranslateTransform x:Name="EyesShift"/>
                </TransformGroup>
              </StackPanel.RenderTransform>
              <Rectangle Width="7" Height="12" RadiusX="3.5" RadiusY="3.5" Fill="{DynamicResource Fg}" Margin="0,0,4,0"/>
              <Rectangle Width="7" Height="12" RadiusX="3.5" RadiusY="3.5" Fill="{DynamicResource Fg}"/>
            </StackPanel>
            <Border x:Name="MiniArt" Width="22" Height="22" CornerRadius="7" Background="{DynamicResource ChipBg}"
                    Visibility="Collapsed"/>
            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{DynamicResource Danger}" Visibility="Collapsed"/>
          </Grid>

          <TextBlock x:Name="CompactTime" Grid.Column="1" Text="00:00" FontSize="13" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     MaxWidth="300" TextTrimming="CharacterEllipsis"/>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <!-- who uses the mic / camera right now (like the iOS dots) -->
            <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FF9F0A" Margin="0,0,5,0" Visibility="Collapsed"/>
            <Ellipse x:Name="CamDot" Width="7" Height="7" Fill="#30D158" Margin="0,0,5,0" Visibility="Collapsed"/>
            <Border x:Name="UnreadBadge" Background="{DynamicResource AccentBlue}" CornerRadius="8" Padding="6,1"
                    Margin="0,0,6,0" Visibility="Collapsed">
              <TextBlock x:Name="UnreadText" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
            </Border>
          <Grid VerticalAlignment="Center">
            <StackPanel x:Name="CompactWeather" Orientation="Horizontal">
              <TextBlock x:Name="CompactWeatherIcon" FontFamily="{StaticResource SymbolFont}" FontSize="13"
                         Foreground="{DynamicResource Warm}" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock x:Name="CompactTemp" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="EqBars" Orientation="Horizontal" Visibility="Collapsed" Height="16">
              <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
            </StackPanel>
          </Grid>
          </StackPanel>
        </Grid>

        <!-- ================= TOAST ================= -->
        <Grid x:Name="ToastView" Height="58" VerticalAlignment="Top" Margin="12,0,18,0" Visibility="Collapsed"
              Opacity="0" Cursor="Hand" MouseLeftButtonUp="Toast_Click" Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="ToastBadge" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource ChipBg}">
            <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource IconFont}" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ToastTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ToastText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>

        <!-- ================= CLAUDE CODE ================= -->
        <Grid x:Name="ClaudeView" Width="512" Margin="16,14,16,16" VerticalAlignment="Top"
              Visibility="Collapsed" Opacity="0">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="✳" FontSize="18" Foreground="{DynamicResource ClaudeOrange}" VerticalAlignment="Center"/>
              <TextBlock Text="Claude Code" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="ClaudeProject" Style="{StaticResource Muted}" Margin="8,1,0,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="ClaudeQueue" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="ClaudeTitle" FontSize="13" Margin="0,10,0,6" TextWrapping="Wrap"/>
            <Border Style="{StaticResource Tile}" Padding="12,10">
              <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ClaudeDetails" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                           TextWrapping="Wrap" Foreground="{DynamicResource Fg}"/>
              </ScrollViewer>
            </Border>
            <StackPanel x:Name="ClaudeAskButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
              <Button Style="{StaticResource Pill}" Content="В терминале" Margin="0,0,8,0" Click="ClaudeTerminal_Click"/>
              <Button Style="{StaticResource Pill}" Content="Запретить" Margin="0,0,8,0" Click="ClaudeDeny_Click"/>
              <Button Style="{StaticResource AccentPill}" Content="Разрешить" Click="ClaudeAllow_Click"/>
            </StackPanel>
            <StackPanel x:Name="ClaudeInfoButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
              <Button Style="{StaticResource Pill}" Content="Копировать" Margin="0,0,8,0" Click="ClaudeCopy_Click"/>
              <Button Style="{StaticResource Pill}" Content="Закрыть" Click="ClaudeClose_Click"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- ================= FILE DROP ================= -->
        <Grid x:Name="DropView" Width="500" Margin="16,14,16,16" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
          <StackPanel>
            <DockPanel>
              <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource ChipBg}">
                <TextBlock x:Name="DropIcon" Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="DropTitle" Text="Отпустите файл на острове" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DropSubtitle" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           Text="Поделиться, сжать в ZIP, конвертировать картинку"/>
              </StackPanel>
            </DockPanel>
            <WrapPanel x:Name="DropActions" Margin="0,12,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>

        <!-- ================= EXPANDED ================= -->
        <Grid x:Name="ExpandedView" Opacity="0" Visibility="Collapsed" Margin="14,10,14,14" VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- header: tabs, clock, settings, hide -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <RadioButton x:Name="TabHome" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Главная" Tag="&#xE80F;" IsChecked="True" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabMusic" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Музыка" Tag="&#xE8D6;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabWeather" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Погода" Tag="&#xE706;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabChat" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Чат" Tag="&#xE8BD;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabTimer" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Таймер" Tag="&#xE916;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabClip" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Буфер" Tag="&#xE77F;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabNotes" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Заметки" Tag="&#xE70B;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabCalendar" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Календарь" Tag="&#xE787;" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabSystem" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Система" Tag="&#xE7FC;" Checked="Tab_Checked"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="ExpandedTime" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <RadioButton x:Name="TabSettings" Style="{StaticResource TabButton}" GroupName="Tabs" Content="Настройки" Tag="&#xE713;" Checked="Tab_Checked"/>
            <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xE70E;"
                    ToolTip="Спрятать (или смахните вверх)" Click="HideIsland_Click"/>
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,10,0,0" x:Name="Pages">

            <!-- ======== HOME ======== -->
            <StackPanel x:Name="HomePage" Width="572">
              <UniformGrid x:Name="ActionsGrid" Columns="4"/>
              <Grid x:Name="HomeStrips" Margin="4,6,4,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="HomeMusic" Style="{StaticResource Tile}" Padding="10" Cursor="Hand"
                        MouseLeftButtonUp="HomeMusic_Click">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HomeArt" Width="44" Height="44" CornerRadius="12" Background="{DynamicResource ChipBg}">
                      <TextBlock x:Name="HomeArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                 Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                      <TextBlock x:Name="HomeTrack" Text="Ничего не играет" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="HomeArtist" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13" Content="&#xE892;" Click="Prev_Click"/>
                      <Button x:Name="HomePlay" Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="15" Content="&#xE768;" Click="PlayPause_Click"/>
                      <Button Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13" Content="&#xE893;" Click="Next_Click"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border x:Name="HomeWeather" Grid.Column="1" Style="{StaticResource Tile}" Width="176" Margin="8,0,0,0"
                        Padding="12,10" Cursor="Hand" MouseLeftButtonUp="HomeWeather_Click">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HomeWIcon" FontFamily="{StaticResource SymbolFont}" FontSize="24"
                               Foreground="{DynamicResource Warm}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="HomeWTemp" Text="—" FontSize="18" FontFamily="{StaticResource DisplayFont}"/>
                      <TextBlock x:Name="HomeWDesc" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Text="Укажите город"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>

            <!-- ======== MUSIC ======== -->
            <Grid x:Name="MusicPage" Width="640" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="214"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Tile}" Margin="0,0,10,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ArtBox" Width="72" Height="72" CornerRadius="16" Background="{DynamicResource ChipBg}">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3"/>
                      </Border.Effect>
                      <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                 Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="TrackTitle" Text="Ничего не играет" FontSize="16" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="TrackArtist" Text="Включите музыку в любом плеере" FontSize="12.5"
                                 Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                      <TextBlock x:Name="TrackSource" FontSize="11" Foreground="{DynamicResource Fg3}"
                                 TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="40"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Elapsed" Text="0:00" FontSize="10.5" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center"/>
                    <Border x:Name="ProgressTrack" Grid.Column="1" Height="16" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="ProgressTrack_MouseLeftButtonDown">
                      <Grid VerticalAlignment="Center" Height="5">
                        <Border Background="{DynamicResource TrackBg}" CornerRadius="2.5"/>
                        <Border x:Name="ProgressFill" Background="{DynamicResource Fg}" CornerRadius="2.5"
                                HorizontalAlignment="Left" Width="0"/>
                      </Grid>
                    </Border>
                    <TextBlock x:Name="Remaining" Grid.Column="2" Text="-0:00" FontSize="10.5" Foreground="{DynamicResource Fg3}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Content="&#xE768;"
                            Margin="18,0" Click="PlayPause_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click"/>
                  </StackPanel>

                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource SoftSlider}"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="VolumeLabel" Grid.Column="2" Style="{StaticResource Muted}" FontSize="11"
                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="70"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Style="{StaticResource Tile}">
                <Grid>
                  <StackPanel x:Name="LyricsPanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="LyricPrev" FontSize="11.5" Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="LyricCur" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="64" Margin="0,8">
                      <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="LyricCurShift"/>
                      </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="LyricNext" FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxHeight="34"/>
                    <TextBlock x:Name="LyricNext2" FontSize="11.5" Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel x:Name="LyricsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource IconFont}" FontSize="20"
                               Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LyricsEmptyText" Text="Здесь появятся слова песни" Style="{StaticResource Muted}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <!-- ======== WEATHER ======== -->
            <Grid x:Name="WeatherPage" Width="680" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <DockPanel Margin="2,0,0,10">
                <TextBlock Text="Город" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="CityBox" Style="{StaticResource SoftBox}" Width="180" Height="30" KeyDown="CityBox_KeyDown"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="13" Width="30" Height="30"
                        Margin="6,0,0,0" ToolTip="Обновить" Click="RefreshWeather_Click"/>
                <TextBlock x:Name="WeatherStatus" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
              </DockPanel>

              <UniformGrid Grid.Row="1" Columns="4" Rows="2">
                <!-- now -->
                <Border Style="{StaticResource Tile}" Margin="0,0,5,5" Height="124">
                  <StackPanel>
                    <TextBlock x:Name="NowPlace" Style="{StaticResource Caption}" Text="СЕЙЧАС" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <TextBlock x:Name="NowIcon" FontFamily="{StaticResource SymbolFont}" FontSize="22"
                                 Foreground="{DynamicResource Warm}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock x:Name="NowTemp" Text="—" FontSize="30" FontWeight="Light" FontFamily="{StaticResource DisplayFont}"/>
                    </StackPanel>
                    <TextBlock x:Name="NowDesc" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NowFeels" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>

                <!-- wind -->
                <Border Style="{StaticResource Tile}" Margin="5,0,5,5" Height="124">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ВЕТЕР"/>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid Width="62" Height="62">
                        <Ellipse Stroke="{DynamicResource TrackBg}" StrokeThickness="2"/>
                        <TextBlock Text="С" FontSize="8.5" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                        <TextBlock Text="Ю" FontSize="8.5" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        <Path Data="M 31,9 L 35.5,26 L 31,23 L 26.5,26 Z M 30.2,23 L 31.8,23 L 31.8,53 L 30.2,53 Z"
                              Fill="{DynamicResource Fg}" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform>
                            <RotateTransform x:Name="WindArrow"/>
                          </Path.RenderTransform>
                        </Path>
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="WindSpeed" Text="—" FontSize="17" FontFamily="{StaticResource DisplayFont}"/>
                        <TextBlock x:Name="WindDir" Style="{StaticResource Muted}" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- humidity -->
                <Border Style="{StaticResource Tile}" Margin="5,0,5,5" Height="124">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ВЛАЖНОСТЬ"/>
                    <TextBlock x:Name="HumidityText" Text="—" FontSize="26" FontFamily="{StaticResource DisplayFont}" Margin="0,6,0,10"/>
                    <Grid Height="6">
                      <Border Background="{DynamicResource TrackBg}" CornerRadius="3"/>
                      <Border Background="#64D2FF" CornerRadius="3" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                          <ScaleTransform x:Name="HumidityScale" ScaleX="0"/>
                        </Border.RenderTransform>
                      </Border>
                    </Grid>
                    <TextBlock x:Name="DewText" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>

                <!-- pressure -->
                <Border Style="{StaticResource Tile}" Margin="5,0,0,5" Height="124">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ДАВЛЕНИЕ"/>
                    <Grid Width="78" Height="50" Margin="0,8,0,0" HorizontalAlignment="Left">
                      <Path x:Name="PressureArcBg" Stroke="{DynamicResource TrackBg}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <Path x:Name="PressureArc" Stroke="{DynamicResource Fg}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <TextBlock x:Name="PressureText" Text="—" FontSize="17" FontFamily="{StaticResource DisplayFont}"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                    </Grid>
                    <TextBlock Text="мм рт. ст." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>

                <!-- sun -->
                <Border Style="{StaticResource Tile}" Margin="0,5,5,0" Height="124">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="СОЛНЦЕ"/>
                    <Canvas Width="120" Height="44" Margin="0,8,0,0" HorizontalAlignment="Left">
                      <Path Data="M 4,40 Q 60,-18 116,40" Stroke="{DynamicResource TrackBg}" StrokeThickness="2" StrokeDashArray="2 2"/>
                      <Line X1="0" X2="120" Y1="40" Y2="40" Stroke="{DynamicResource TrackBg}" StrokeThickness="1"/>
                      <Ellipse x:Name="SunDot" Width="12" Height="12" Fill="{DynamicResource Warm}">
                        <Ellipse.Effect>
                          <DropShadowEffect Color="#FFD60A" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                      </Ellipse>
                    </Canvas>
                    <Grid Margin="0,6,0,0">
                      <TextBlock x:Name="SunriseText" Style="{StaticResource Muted}" FontSize="11"/>
                      <TextBlock x:Name="SunsetText" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- uv -->
                <Border Style="{StaticResource Tile}" Margin="5,5,5,0" Height="124">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="УФ-ИНДЕКС"/>
                    <TextBlock x:Name="UvText" Text="—" FontSize="26" FontFamily="{StaticResource DisplayFont}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="UvDesc" Style="{StaticResource Muted}" FontSize="11"/>
                    <Grid Height="6" Margin="0,10,0,0">
                      <Border CornerRadius="3">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#30D158" Offset="0"/>
                            <GradientStop Color="#FFD60A" Offset="0.3"/>
                            <GradientStop Color="#FF9F0A" Offset="0.55"/>
                            <GradientStop Color="#FF453A" Offset="0.8"/>
                            <GradientStop Color="#BF5AF2" Offset="1"/>
                          </LinearGradientBrush>
                        </Border.Background>
                      </Border>
                      <Canvas>
                        <Ellipse x:Name="UvMarker" Width="10" Height="10" Fill="White" Stroke="Black" StrokeThickness="1" Canvas.Top="-2"/>
                      </Canvas>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- precipitation -->
                <Border Style="{StaticResource Tile}" Margin="5,5,5,0" Height="124">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ОСАДКИ"/>
                    <TextBlock x:Name="PrecipText" Text="—" FontSize="26" FontFamily="{StaticResource DisplayFont}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="PrecipDesc" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- hourly -->
                <Border Style="{StaticResource Tile}" Margin="5,5,0,0" Height="124">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ПО ЧАСАМ"/>
                    <UniformGrid x:Name="HoursPanel" Rows="1" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
            </Grid>

            <!-- ======== CHAT ======== -->
            <Grid x:Name="ChatPage" Width="640" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,10">
                <Border Background="{DynamicResource TileBg}" CornerRadius="14" Padding="3">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ChatClaude" Style="{StaticResource Segment}" GroupName="Chat" Content="Claude" Checked="ChatProvider_Checked"/>
                    <RadioButton x:Name="ChatGemini" Style="{StaticResource Segment}" GroupName="Chat" Content="Gemini" Checked="ChatProvider_Checked"/>
                    <RadioButton x:Name="ChatDeepSeek" Style="{StaticResource Segment}" GroupName="Chat" Content="DeepSeek" Checked="ChatProvider_Checked"/>
                  </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Muted}" Text="войдите в аккаунт один раз — ключи не нужны"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xE72C;" ToolTip="Обновить" Click="ChatReload_Click"/>
                  <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xE8A7;" ToolTip="Открыть в браузере" Click="ChatOpenExternal_Click"/>
                </StackPanel>
              </DockPanel>
              <Border Grid.Row="1" CornerRadius="18" Height="470" Background="{DynamicResource TileBg}"
                      BorderBrush="{DynamicResource TileStroke}" BorderThickness="1" x:Name="ChatFrame">
                <Grid x:Name="ChatHost">
                  <TextBlock x:Name="ChatPlaceholder" Text="Загружаю чат…" Style="{StaticResource Muted}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>

            <!-- ======== TIMER ======== -->
            <StackPanel x:Name="TimerPage" Width="580" Visibility="Collapsed">
              <Border Background="{DynamicResource TileBg}" CornerRadius="14" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="TimerModeTimer" Style="{StaticResource Segment}" GroupName="TimerMode" Content="Таймер" IsChecked="True" Checked="TimerMode_Checked"/>
                  <RadioButton x:Name="TimerModePomodoro" Style="{StaticResource Segment}" GroupName="TimerMode" Content="Помодоро" Checked="TimerMode_Checked"/>
                  <RadioButton x:Name="TimerModeStopwatch" Style="{StaticResource Segment}" GroupName="TimerMode" Content="Секундомер" Checked="TimerMode_Checked"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="132" Height="132">
                    <Ellipse Stroke="{DynamicResource TrackBg}" StrokeThickness="7"/>
                    <Path x:Name="TimerRing" Stroke="{DynamicResource Accent}" StrokeThickness="7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock x:Name="TimerBig" Text="05:00" FontSize="30" FontFamily="{StaticResource DisplayFont}"
                                 HorizontalAlignment="Center"/>
                      <TextBlock x:Name="TimerPhase" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <WrapPanel x:Name="TimerPresets"/>
                    <StackPanel x:Name="TimerCustomRow" Orientation="Horizontal" Margin="0,4,0,0">
                      <TextBox x:Name="TimerMinutesBox" Style="{StaticResource SoftBox}" Width="64" Height="30" Text="5"
                               KeyDown="TimerMinutesBox_KeyDown"/>
                      <TextBlock Text="мин" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PomodoroFocusSwitch" Style="{StaticResource Switch}" Margin="0,8,0,0" Visibility="Collapsed"
                              Content="«Не беспокоить» во время работы" Click="PomodoroFocus_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                      <Button x:Name="TimerStartButton" Style="{StaticResource AccentPill}" Content="Старт" Click="TimerStart_Click" Margin="0,0,8,0"/>
                      <Button x:Name="TimerResetButton" Style="{StaticResource Pill}" Content="Сброс" Click="TimerReset_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <!-- ======== CLIPBOARD ======== -->
            <StackPanel x:Name="ClipPage" Width="580" Visibility="Collapsed">
              <DockPanel Margin="2,0,0,8">
                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Text="Нажмите, чтобы вставить туда, где вы печатали. Хранится только в памяти."/>
                <Button Style="{StaticResource Pill}" Content="Очистить" HorizontalAlignment="Right" Padding="12,5" Click="ClipClear_Click"/>
              </DockPanel>
              <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="ClipList"/>
              </ScrollViewer>
            </StackPanel>

            <!-- ======== NOTES ======== -->
            <StackPanel x:Name="NotesPage" Width="580" Visibility="Collapsed">
              <TextBox x:Name="NewNoteBox" Style="{StaticResource SoftBox}" MinHeight="36" AcceptsReturn="False"
                       TextWrapping="Wrap" KeyDown="NewNoteBox_KeyDown"/>
              <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="4,4,0,8"
                         Text="Enter — сохранить заметку. Нажмите на заметку, чтобы скопировать."/>
              <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="NotesList"/>
              </ScrollViewer>
            </StackPanel>

            <!-- ======== CALENDAR ======== -->
            <StackPanel x:Name="CalendarPage" Width="580" Visibility="Collapsed">
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Caption}" Text="БЛИЖАЙШЕЕ"/>
                  <StackPanel x:Name="EventsList" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Caption}" Text="НАПОМНИТЬ"/>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ReminderTitleBox" Style="{StaticResource SoftBox}" Height="30" KeyDown="Reminder_KeyDown"/>
                    <TextBox x:Name="ReminderWhenBox" Grid.Column="1" Style="{StaticResource SoftBox}" Height="30" Margin="8,0,0,0"
                             KeyDown="Reminder_KeyDown"/>
                    <Button Grid.Column="2" Style="{StaticResource AccentPill}" Content="Добавить" Margin="8,0,0,0" Click="ReminderAdd_Click"/>
                  </Grid>
                  <TextBlock x:Name="ReminderHint" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                             Text="Время: 18:30, завтра 9:00, через 20 мин, 15.11 14:00"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Caption}" Text="GOOGLE / OUTLOOK / ЛЮБОЙ КАЛЕНДАРЬ (ICS)"/>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IcsBox" Style="{StaticResource SoftBox}" Height="30"/>
                    <Button Grid.Column="1" Style="{StaticResource Pill}" Content="Подключить" Margin="8,0,0,0" Click="IcsApply_Click"/>
                  </Grid>
                  <TextBlock x:Name="IcsStatus" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="Google Календарь → Настройки календаря → «Секретный адрес в формате iCal»."/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ======== SYSTEM ======== -->
            <StackPanel x:Name="SystemPage" Width="600" Visibility="Collapsed">
              <UniformGrid Columns="3">
                <Border Style="{StaticResource Tile}" Margin="0,0,5,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ПРОЦЕССОР"/>
                    <TextBlock x:Name="CpuText" Text="—" FontSize="24" FontFamily="{StaticResource DisplayFont}" Margin="0,4,0,8"/>
                    <Grid Height="5"><Border Background="{DynamicResource TrackBg}" CornerRadius="2.5"/>
                      <Border Background="{DynamicResource AccentBlue}" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="CpuBar" ScaleX="0"/></Border.RenderTransform></Border></Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="5,0,5,0">
                  <StackPanel>
                    <TextBlock x:Name="GpuCaption" Style="{StaticResource Caption}" Text="ВИДЕОКАРТА" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="GpuText" Text="—" FontSize="24" FontFamily="{StaticResource DisplayFont}" Margin="0,4,0,8"/>
                    <Grid Height="5"><Border Background="{DynamicResource TrackBg}" CornerRadius="2.5"/>
                      <Border Background="{DynamicResource Accent}" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="GpuBar" ScaleX="0"/></Border.RenderTransform></Border></Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="5,0,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ПАМЯТЬ"/>
                    <TextBlock x:Name="RamText" Text="—" FontSize="24" FontFamily="{StaticResource DisplayFont}" Margin="0,4,0,8"/>
                    <Grid Height="5"><Border Background="{DynamicResource TrackBg}" CornerRadius="2.5"/>
                      <Border Background="#BF5AF2" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="RamBar" ScaleX="0"/></Border.RenderTransform></Border></Grid>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <UniformGrid Columns="2" Margin="0,10,0,0">
                <!-- Discord voice -->
                <Border Style="{StaticResource Tile}" Margin="0,0,5,0">
                  <StackPanel>
                    <DockPanel>
                      <Border x:Name="DiscordBadge" Width="34" Height="34" CornerRadius="17" Background="#5865F2">
                        <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Discord" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DiscordStatus" Style="{StaticResource Muted}" Text="Не в голосовом канале"/>
                      </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button x:Name="MicMuteButton" Style="{StaticResource Pill}" Content="Микрофон: вкл" Padding="12,5"
                              Margin="0,0,6,0" Click="MicMute_Click"/>
                      <Button x:Name="DiscordMuteButton" Style="{StaticResource Pill}" Content="Звук Discord: вкл" Padding="12,5"
                              Click="DiscordMute_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <!-- focus -->
                <Border Style="{StaticResource Tile}" Margin="5,0,0,0">
                  <StackPanel>
                    <DockPanel>
                      <Border Width="34" Height="34" CornerRadius="17" Background="#5E5CE6">
                        <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Не беспокоить" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FocusStatus" Style="{StaticResource Muted}" Text="Выключено"/>
                      </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,10,0,0">
                      <Button Style="{StaticResource Pill}" Content="30 мин" Padding="11,5" Margin="0,0,6,6" Tag="30" Click="Focus_Click"/>
                      <Button Style="{StaticResource Pill}" Content="1 ч" Padding="11,5" Margin="0,0,6,6" Tag="60" Click="Focus_Click"/>
                      <Button Style="{StaticResource Pill}" Content="2 ч" Padding="11,5" Margin="0,0,6,6" Tag="120" Click="Focus_Click"/>
                      <Button x:Name="FocusOffButton" Style="{StaticResource Pill}" Content="Выключить" Padding="11,5" Margin="0,0,6,6" Tag="0" Click="Focus_Click"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <UniformGrid Columns="2" Margin="0,10,0,0">
                <Border Style="{StaticResource Tile}" Margin="0,0,5,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="МИКРОФОН И КАМЕРА СЕЙЧАС"/>
                    <TextBlock x:Name="PrivacyText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5" Text="Никто не использует"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="5,0,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ЗАРЯД УСТРОЙСТВ"/>
                    <TextBlock x:Name="BatteryText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5" Text="Проверяю…"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>

            <!-- ======== SETTINGS ======== -->
            <ScrollViewer x:Name="SettingsPage" Width="600" MaxHeight="470" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Hidden">
              <StackPanel>
                <Border Style="{StaticResource Tile}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ВНЕШНИЙ ВИД"/>
                    <CheckBox x:Name="DarkSwitch" Style="{StaticResource Switch}" Margin="0,8,0,4" Click="DarkSwitch_Click">
                      <StackPanel>
                        <TextBlock Text="Тёмная тема"/>
                        <TextBlock Text="Переключить в любой момент: Ctrl+Alt+T" Style="{StaticResource Muted}" FontSize="11"/>
                      </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="LiquidSwitch" Style="{StaticResource Switch}" Margin="0,4,0,4" Click="Liquid_Click">
                      <StackPanel>
                        <TextBlock Text="Живые волны"/>
                        <TextBlock Text="Остров тянется, колышется и расходится кругами от касаний. Выключено — спокойная плавная анимация" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                      </StackPanel>
                    </CheckBox>
                    <TextBlock Text="Цвет острова" Margin="0,10,0,8"/>
                    <WrapPanel x:Name="SwatchPanel" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <TextBox x:Name="ColorBox" Style="{StaticResource SoftBox}" Width="110" Height="30" KeyDown="ColorBox_KeyDown"/>
                      <Button Style="{StaticResource Pill}" Content="Применить" Margin="8,0,0,0" Click="ColorApply_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ГЛАВНАЯ — СОБЕРИТЕ ПОД СЕБЯ"/>
                    <WrapPanel Margin="0,10,0,0">
                      <CheckBox x:Name="HomeActionsChip" Style="{StaticResource ChipToggle}" Content="Быстрые действия" Click="HomeLayout_Click"/>
                      <CheckBox x:Name="HomeMusicChip" Style="{StaticResource ChipToggle}" Content="Музыка" Click="HomeLayout_Click"/>
                      <CheckBox x:Name="HomeWeatherChip" Style="{StaticResource ChipToggle}" Content="Погода" Click="HomeLayout_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Кнопки действий" Style="{StaticResource Muted}" Margin="0,6,0,8"/>
                    <WrapPanel x:Name="ActionChips"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ПОВЕДЕНИЕ"/>
                    <CheckBox x:Name="HoverSwitch" Style="{StaticResource Switch}" Margin="0,8,0,4" Click="Behavior_Click" Content="Раскрывать при наведении"/>
                    <CheckBox x:Name="FullscreenSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Прятать в играх и полноэкранном режиме"/>
                    <CheckBox x:Name="GameStatsSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="В играх показывать CPU / GPU / RAM вместо полного скрытия"/>
                    <CheckBox x:Name="KaraokeSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Слова песни прямо в острове (караоке)"/>
                    <CheckBox x:Name="NotifySwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Сообщения Telegram, Discord, Viber… на острове"/>
                    <CheckBox x:Name="NotifyAllSwitch" Style="{StaticResource Switch}" Click="Behavior_Click" Content="Уведомления всех приложений, не только мессенджеров"/>
                    <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="Autostart_Click" Content="Запускать вместе с Windows"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Остров можно перетащить куда угодно. Смахните его вверх, чтобы спрятать. Вернуть: клик или потянуть вниз полоску у верхнего края, Ctrl+Alt+I или значок в трее."/>
                    <Button Style="{StaticResource Pill}" Content="Вернуть остров в центр" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="ResetPosition_Click"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="ДЕЙСТВИЯ"/>
                    <TextBlock Text="Команда для кнопки «Команда»" Margin="0,10,0,6"/>
                    <TextBox x:Name="CommandBox" Style="{StaticResource SoftBox}" Height="30" LostFocus="CommandBox_LostFocus"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                               Text="Например: notepad, calc, или любой путь / ссылка / команда cmd"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <TextBlock Text="Переводить на язык" VerticalAlignment="Center" Margin="0,0,10,0"/>
                      <TextBox x:Name="TranslateBox" Style="{StaticResource SoftBox}" Width="60" Height="30" LostFocus="TranslateBox_LostFocus"/>
                      <TextBlock Style="{StaticResource Muted}" Text="ru, en, uk, de…" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="RecSysSwitch" Style="{StaticResource Switch}" Margin="0,10,0,4" Click="RecordAudio_Click" Content="Запись экрана: звук компьютера"/>
                    <CheckBox x:Name="RecMicSwitch" Style="{StaticResource Switch}" Click="RecordAudio_Click" Content="Запись экрана: микрофон"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Горячие клавиши: Ctrl+Alt+S — скриншот области, Ctrl+Alt+R — запись экрана, Ctrl+Alt+I — показать/спрятать остров."/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Tile}" Margin="0,10,0,0">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="✳" FontSize="16" Foreground="{DynamicResource ClaudeOrange}" VerticalAlignment="Center"/>
                      <TextBlock Style="{StaticResource Caption}" Text="CLAUDE CODE" VerticalAlignment="Center" Margin="8,0,0,0"/>
                      <Button x:Name="ClaudeHooksButton" Style="{StaticResource Pill}" HorizontalAlignment="Right"
                              Content="Подключить" Click="ClaudeHooks_Click"/>
                    </DockPanel>
                    <TextBlock x:Name="ClaudeHooksStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>

                <Button Style="{StaticResource Pill}" Content="Выйти из Dynamic Island" HorizontalAlignment="Center"
                        Margin="0,12,0,4" Click="Exit_Click"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- ripples from clicks spread here (clipped to the island) -->
        <Canvas x:Name="RippleLayer" IsHitTestVisible="False"/>
      </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
