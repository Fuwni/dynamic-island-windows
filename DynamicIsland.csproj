<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DynamicIsland</RootNamespace>
    <AssemblyName>DynamicIsland</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

    <Version>1.5.1</Version>
    <Product>Atoll</Product>
    <AssemblyTitle>Atoll</AssemblyTitle>
    <Description>Atoll, a Dynamic Island-style island for Windows: music, lyrics, weather, timers, screenshots, chat and more at the top of the screen.</Description>
    <Copyright>Copyright (c) 2026 mykolaichechelnytskyi, MIT License</Copyright>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>

    <!-- ScreenRecorderLib is native x64; keep the output path without a platform folder. -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon and GDI capture; keep its names out of the way. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\claude-hook.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\icon.ico" />
    <EmbeddedResource Include="Assets\lang\*.json" />
  </ItemGroup>

</Project>
