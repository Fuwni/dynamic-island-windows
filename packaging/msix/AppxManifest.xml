<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package (MSIX). Built by tools/make-msix.ps1; {VERSION} is filled in from the .csproj. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop desktop6 rescap">

  <Identity Name="Mykolai.AtollIsland"
            Publisher="CN=C6CDEA23-7F15-4A37-A55E-B90996D509A7"
            Version="{VERSION}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Atoll Island</DisplayName>
    <PublisherDisplayName>Mykolai</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <!-- settings, notes and the Claude Code bridge live in the same folders as in the regular version,
         where Claude Code (another program) can reach them -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="ru-RU" />
    <Resource Language="uk-UA" />
    <Resource Language="es-ES" />
    <Resource Language="de-DE" />
    <Resource Language="pt-BR" />
    <Resource Language="zh-CN" />
  </Resources>

  <Applications>
    <Application Id="Atoll" Executable="DynamicIsland.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Atoll"
                          Description="A Dynamic Island-style island for Windows: music with lyrics, live activities, screenshots, weather and more."
                          BackgroundColor="transparent"
                          Square150x150Logo="Images\Square150x150Logo.png"
                          Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows": off until the user turns it on in Atoll (or in Settings > Apps > Startup) -->
        <desktop:Extension Category="windows.startupTask" Executable="DynamicIsland.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="AtollStartup" Enabled="false" DisplayName="Atoll" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
